# OpenAI (optional: without it a deterministic offline mock compiler and planner are used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayPal SANDBOX app credentials (optional: without them a clearly labelled mock PayPal is used)
# The same app credentials are used for Orders v2 (spend) and Invoicing v2 (bill).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Route invoice send/status/remind and order create/get/capture through the official PayPal Agent Toolkit (default true); false = direct REST
PAYPAL_USE_AGENT_TOOLKIT=true

# Mock-only: flip SENT invoices to PAID after a few status checks (for demoing the collect step)
MOCK_PAYPAL_AUTOPAY=false

# Public base URL used as the PayPal order return/cancel URL (set to the Vercel production URL in production)
# SPENDGUARD_PUBLIC_URL=https://your-app.vercel.app

# Local/tests: JSON file store (default data/db.json)
# SPENDGUARD_DB=data/db.json

# Production (Vercel): Upstash Redis. When both are set, the file store is not used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace also injects these aliases; the store accepts either pair.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
